# Connplex B2C Frontend Environment Configuration
# Copy this file to .env in your root directory and fill in your real credentials.

# Google Analytics 4 Measurement ID (e.g. G-D1H5J58TNY)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Environment mode (development / production)
VITE_ENV=development

# Maintenance Mode (true / false)
VITE_MAINTENANCE_MODE=false

# API Server URL (leave empty to fallback to default logic based on local/prod hostname)
# VITE_BASE_URL=http://localhost:3020/api
# VITE_IMAGE_URL=http://localhost:3020/api/uploads
